<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3 shadow-sm border-bottom border-dark-subtle">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/Index">
                    <span class="brand-logo"><i class="bi bi-cpu text-primary fs-4"></i></span>
                    <span class="fs-5 tracking-tight">TechStore <span class="badge bg-primary text-white fw-normal fs-6">Admin</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor" aria-controls="navbarColor" aria-expanded="false" aria-label="Navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarColor">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link" href="/Index"><i class="bi bi-house me-1"></i> Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/AltaProducto"><i class="bi bi-plus-circle me-1"></i> Alta</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/ConsultaProducto"><i class="bi bi-search me-1"></i> Consulta</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/ModificacionProducto"><i class="bi bi-pencil-square me-1"></i> Modificación</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/BajaProducto"><i class="bi bi-trash3 me-1"></i> Baja</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="flex-grow-1">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top py-4 mt-auto text-secondary small">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                &copy; 2026 <strong>TechStore Online</strong> · Sistema de Gestión
            </div>
            <div class="text-muted">
                Laboratorio de Programación 3  Ana Valentina Vargas
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
