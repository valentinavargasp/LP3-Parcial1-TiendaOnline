@page
@model parcial1.Pages.AltaProductoModel
@{
    ViewData["Title"] = "Alta de Producto";
}

<!--
    ==========================================================================
    Formulario de Alta
    ==========================================================================
-->

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <!-- Barra superior con título e hipervínculo de navegación -->
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h3 class="fw-bold text-dark mb-1">
                        <i class="bi bi-box-seam text-primary me-2"></i>Alta de Producto
                    </h3>
                    <p class="text-secondary small mb-0">Ingrese los datos para registrar un nuevo artículo en la tienda.</p>
                </div>
                <!-- Hipervínculo a la página principal  -->
                <a href="/Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Menú
                </a>
            </div>

            <!-- Alertas de estado -->
            @if (!string.IsNullOrEmpty(Model.MensajeExito))
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @Model.MensajeExito
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.MensajeError))
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @Model.MensajeError
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

            <!-- Tarjeta del formulario -->
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form method="post" novalidate>
                        <!-- Campo Nombre TextBox -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary" for="nombreProducto">
                                Nombre del Producto <span class="text-danger">*</span>
                            </label>
                            <input type="text" 
                                   id="nombreProducto"
                                   name="Nombre" 
                                   asp-for="Nombre" 
                                   class="form-control form-control-lg" 
                                   placeholder="Ej: Teclado Mecánico RGB" 
                                   required />
                        </div>

                        <!-- Campo Precio TextBox con formato numérico -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary" for="precioProducto">
                                Precio ($) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light">$</span>
                                <input type="number" 
                                       step="0.01" 
                                       min="0.01"
                                       id="precioProducto"
                                       name="Precio" 
                                       asp-for="Precio" 
                                       class="form-control" 
                                       placeholder="0.00" 
                                       required />
                            </div>
                        </div>

                        <!-- Campo Categoría DropDownList poblado desde la base de datos -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary" for="categoriaProducto">
                                Categoría <span class="text-danger">*</span>
                            </label>
                            <select id="categoriaProducto"
                                    name="IdCategoria" 
                                    asp-for="IdCategoria" 
                                    asp-items="Model.Categorias" 
                                    class="form-select form-select-lg" 
                                    required>
                                <option value="">-- Seleccione una categoría --</option>
                            </select>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a href="/Index" class="btn btn-light px-4 py-2 border">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Confirmar
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Hipervínculo inferior adicional -->
            <div class="text-center mt-4">
                <a href="/Index" class="text-decoration-none text-muted small">
                    <i class="bi bi-house me-1"></i> Volver al Menú principal
                </a>
            </div>
        </div>
    </div>
</div>
