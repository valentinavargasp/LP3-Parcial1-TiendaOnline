@page
@model parcial1.Pages.IndexModel
@{
    ViewData["Title"] = "Panel de Control - Tienda Online";
}

<!--
    ==========================================================================
    Navegación y Estructura del Proyecto 
    ==========================================================================
-->

<div class="container py-4">
    <!-- Banner de Bienvenida -->
    <div class="p-4 p-md-5 mb-4 rounded-4 hero-banner text-white shadow-sm">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-primary px-3 py-2 text-uppercase mb-2">Administración</span>
                <h1 class="display-6 fw-bold mb-2">Gestión de Tienda Online</h1>
                <p class="lead mb-0 text-light opacity-90">
                    Panel integral de administración de catálogo, precios y categorías de productos.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                <div class="card bg-white text-dark shadow-sm border-0 rounded-4">
                    <div class="card-body p-3 text-start">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="small fw-semibold text-muted">Base de Datos:</span>
                            @if (Model.BaseConectada)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <span class="status-indicator bg-success me-1"></span> Conectado
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                    <span class="status-indicator bg-danger me-1"></span> Desconectado
                                </span>
                            }
                        </div>
                        <div class="d-flex justify-content-between small text-muted border-top pt-2">
                            <span>Total Productos:</span>
                            <strong class="text-primary">@Model.CantidadProductos</strong>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>Categorías Disponibles:</span>
                            <strong class="text-dark">@Model.CantidadCategorias</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Menú de Módulos (CRUD) con Hipervínculos Requeridos -->
    <div class="row g-4 my-2">
        <!-- 1. Alta de Producto -->
        <div class="col-12 col-md-6">
            <div class="card h-100 border-0 shadow-sm module-card rounded-4 p-2">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="module-icon bg-primary-subtle text-primary">
                            <i class="bi bi-plus-lg fs-3"></i>
                        </div>
                        <div>
                            <h5 class="card-title fw-bold text-dark mb-0">Alta de Producto</h5>
                            <span class="badge bg-light text-muted border">Registrar nuevo</span>
                        </div>
                    </div>
                    <p class="card-text text-muted small flex-grow-1">
                        Cargar nuevos artículos al catálogo especificando nombre, precio y seleccionando la categoría.
                    </p>
                    <!-- Hipervínculo a Formulario de Alta -->
                    <a href="/AltaProducto" class="btn btn-outline-primary fw-semibold w-100 mt-2">
                        Nuevo Producto &rarr;
                    </a>
                </div>
            </div>
        </div>

        <!-- 2. Consulta de Productos -->
        <div class="col-12 col-md-6">
            <div class="card h-100 border-0 shadow-sm module-card rounded-4 p-2">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="module-icon bg-info-subtle text-info">
                            <i class="bi bi-search fs-3"></i>
                        </div>
                        <div>
                            <h5 class="card-title fw-bold text-dark mb-0">Consulta y Catálogo</h5>
                            <span class="badge bg-light text-muted border">Listado</span>
                        </div>
                    </div>
                    <p class="card-text text-muted small flex-grow-1">
                        Visualizar el inventario completo mediante consulta relacional entre productos y categorías, con buscador por código o nombre.
                    </p>
                    <!-- Hipervínculo a Formulario de Consulta -->
                    <a href="/ConsultaProducto" class="btn btn-outline-info text-dark fw-semibold w-100 mt-2">
                        Ver Catálogo &rarr;
                    </a>
                </div>
            </div>
        </div>

        <!-- 3. Modificación de Producto -->
        <div class="col-12 col-md-6">
            <div class="card h-100 border-0 shadow-sm module-card rounded-4 p-2">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="module-icon bg-warning-subtle text-warning">
                            <i class="bi bi-pencil-square fs-3"></i>
                        </div>
                        <div>
                            <h5 class="card-title fw-bold text-dark mb-0">Modificación de Producto</h5>
                            <span class="badge bg-light text-muted border">Edición con validación</span>
                        </div>
                    </div>
                    <p class="card-text text-muted small flex-grow-1">
                        Actualizar información de artículos y reasignar categorías, con validación de negocio que impide guardar sin cambios reales.
                    </p>
                    <!-- Hipervínculo a Formulario de Modificación -->
                    <a href="/ModificacionProducto" class="btn btn-outline-warning text-dark fw-semibold w-100 mt-2">
                        Editar Producto &rarr;
                    </a>
                </div>
            </div>
        </div>

        <!-- 4. Baja de Producto -->
        <div class="col-12 col-md-6">
            <div class="card h-100 border-0 shadow-sm module-card rounded-4 p-2">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="module-icon bg-danger-subtle text-danger">
                            <i class="bi bi-trash3 fs-3"></i>
                        </div>
                        <div>
                            <h5 class="card-title fw-bold text-dark mb-0">Baja de Producto</h5>
                            <span class="badge bg-light text-muted border">Eliminación segura</span>
                        </div>
                    </div>
                    <p class="card-text text-muted small flex-grow-1">
                        Eliminar productos del inventario con confirmación del usuario, manteniendo intactas todas las categorías del sistema.
                    </p>
                    <!-- Hipervínculo a Formulario de Baja -->
                    <a href="/BajaProducto" class="btn btn-outline-danger fw-semibold w-100 mt-2">
                        Dar de Baja &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
