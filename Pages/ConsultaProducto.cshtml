@page
@model parcial1.Pages.ConsultaProductoModel
@{
    ViewData["Title"] = "Consulta de Productos";
}

<!--
    ==========================================================================
    Formulario de Consulta
    ==========================================================================
-->

<div class="container py-4">
    <!-- Barra superior con título e hipervínculo de retorno -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-search text-primary me-2"></i>Catálogo de Productos
            </h3>
            <p class="text-secondary small mb-0">Listado general de artículos con su categoría asignada mediante consulta JOIN.</p>
        </div>
        <!-- Hipervínculo para retornar a la página principal -->
        <a href="/Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver al Menú
        </a>
    </div>

    <!-- Filtros y Búsqueda -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-8 col-lg-9">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" 
                               name="CriterioBusqueda" 
                               asp-for="CriterioBusqueda" 
                               class="form-control border-start-0" 
                               placeholder="Buscar por código exacto (ID) o nombre del producto..." />
                    </div>
                </div>
                <div class="col-md-4 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1 fw-semibold">
                        Buscar
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.CriterioBusqueda))
                    {
                        <a href="/ConsultaProducto" class="btn btn-light border" title="Limpiar filtro">
                            Limpiar
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Indicadores de métricas -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="text-muted small fw-semibold text-uppercase">Productos Listados</div>
                <div class="h4 fw-bold text-dark mb-0">@Model.TotalRegistros</div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="text-muted small fw-semibold text-uppercase">Valor Total Estimado</div>
                <div class="h4 fw-bold text-success mb-0">@Model.TotalValorInventario.ToString("C")</div>
            </div>
        </div>
    </div>

    <!-- Grilla / Tabla de Productos -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width: 70px;">ID</th>
                        <th>Producto</th>
                        <th class="text-end" style="width: 160px;">Precio</th>
                        <th style="width: 230px;">Categoría</th>
                        <th class="text-center" style="width: 170px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaProductos.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                No se encontraron productos registrados con el criterio especificado.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var prod in Model.ListaProductos)
                        {
                            <tr>
                                <td class="text-center fw-bold text-secondary">
                                    #@prod.IdProducto
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@prod.Nombre</span>
                                </td>
                                <td class="text-end fw-bold text-dark font-monospace">
                                    @prod.Precio.ToString("C")
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        @prod.Categoria
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/ModificacionProducto?id=@prod.IdProducto" 
                                           class="btn btn-outline-secondary" 
                                           title="Modificar producto">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="/BajaProducto?id=@prod.IdProducto" 
                                           class="btn btn-outline-danger" 
                                           title="Dar de baja">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Hipervínculo inferior adicional -->
    <div class="text-center mt-4">
        <a href="/Index" class="text-decoration-none text-muted small">
            <i class="bi bi-house me-1"></i> Volver al Menú principal
        </a>
    </div>
</div>
